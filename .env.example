# Security & Environment Configuration
PROJECT_NAME="Explainable Application Privacy and Permission Analyzer"
ENV="development"
SECRET_KEY="super-secret-key-change-this-in-production-cybersecurity-ps02"
ALGORITHM="HS256"

# Token Expiry Security Policies
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_REMEMBER_DAYS=30

# Login Rate Limiting & Throttling
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Database Configuration (SQLite for local dev, Postgres compatible)
# For SQLite: sqlite:///./privacy_analyzer.db
# For PostgreSQL: postgresql://user:password@localhost:5432/privacy_analyzer
DATABASE_URL="sqlite:///./privacy_analyzer.db"

# Admin Setup Default Credentials
DEFAULT_ADMIN_EMAIL="admin@privacyanalyzer.local"
DEFAULT_ADMIN_PASSWORD="AdminSecurePassword123!"

# Backend Server Configuration
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=8501

# Report Storage Path
REPORT_OUTPUT_DIR="./reports"
