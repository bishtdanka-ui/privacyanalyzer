# =============================================================================
# PrivacyGuard — Environment Configuration Template
# Problem Statement: PS02 - Explainable Application Privacy & Permission Analyzer
# =============================================================================

# Project Metadata
PROJECT_NAME="Explainable Application Privacy and Permission Analyzer"
APP_VERSION="1.0.0"

# Environment Mode: "development" or "production"
ENV="development"

# Cryptographic Secret Key for JWT Signing
# IMPORTANT: In production, generate a cryptographically random secret with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="super-secret-key-change-this-in-production-cybersecurity-ps02"
ALGORITHM="HS256"

# -----------------------------------------------------------------------------
# Token Security Policies & Lifespans
# -----------------------------------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=15        # Short-lived access token
REFRESH_TOKEN_EXPIRE_DAYS=7          # Rotating refresh token
REFRESH_TOKEN_REMEMBER_DAYS=30       # Extended session lifespan for remember-me

# -----------------------------------------------------------------------------
# Rate Limiting & Brute-Force Throttling
# -----------------------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5                 # Maximum failed login attempts before lockout
LOCKOUT_MINUTES=15                   # Account lockout period in minutes

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Development (SQLite):
DATABASE_URL="sqlite:///./privacy_analyzer.db"

# Production (PostgreSQL):
# Replace with your production PostgreSQL credentials:
# DATABASE_URL="postgresql://postgres:StrongProductionPassword@localhost:5432/privacyguard_db"

# -----------------------------------------------------------------------------
# File Upload & Analysis Payload Limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5                 # Maximum AndroidManifest.xml upload size (in MB)
MAX_POLICY_LENGTH=1000000            # Maximum privacy policy text length (in characters)

# -----------------------------------------------------------------------------
# Default Administrator Initialization (Only seeded on empty database)
# -----------------------------------------------------------------------------
DEFAULT_ADMIN_EMAIL="admin@privacyanalyzer.local"
DEFAULT_ADMIN_PASSWORD="ChangeMeInProduction!123"

# -----------------------------------------------------------------------------
# Server Networking & Ports
# -----------------------------------------------------------------------------
BACKEND_HOST="127.0.0.1"
BACKEND_PORT=8000
FRONTEND_PORT=8501

# API Base URL accessed by Streamlit Frontend
BACKEND_API_URL="http://127.0.0.1:8000/api/v1"

# Allowed CORS Origins (Comma-separated in production, e.g. "https://privacyguard.example.com")
CORS_ORIGINS="*"

# -----------------------------------------------------------------------------
# Storage Paths
# -----------------------------------------------------------------------------
REPORT_OUTPUT_DIR="./reports"
UPLOAD_TEMP_DIR="./uploads"
