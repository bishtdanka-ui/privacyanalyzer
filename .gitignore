# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.pyd

# Environments
.env
.env.local
.env.*.local
venv/
.venv/
env/
ENV/

# Database files containing user data
*.db
*.db-journal
*.sqlite
*.sqlite3

# Test & coverage caches
.pytest_cache/
.coverage
htmlcov/

# User uploads & private reports (preserve directory structure via .gitkeep)
reports/*.pdf
reports/*.json
reports/*.csv
uploads/*
!uploads/.gitkeep
!reports/.gitkeep

# System & Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
logs/

# Distribution & Build
*.egg-info/
dist/
build/
